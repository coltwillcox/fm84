msgstr Tavaszi nagytakarítás - törölj 1000 dolgot

msgid  Name dropper - rename 1000 files
msgstr Keresztapa - nevezz át 1000 fájlt

msgid  Déjà vu - find a gigabyte of copies
msgstr Déjà vu - találj egy gigabájtnyi másolatot

msgid  Time traveller - open a git revision
msgstr Időutazó - nyiss meg egy git revíziót

msgid  Outrun progress bar
msgstr Outrun folyamatjelző

msgid  Burst what is deleted for good
msgstr Végleg törölt szétrobbantása


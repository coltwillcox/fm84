msgstr Alt+B - A mixtape-re; Alt+Shift+B listázza őket

msgid  Ctrl+E - Edit the names as text
msgstr Ctrl+E - A nevek szerkesztése szövegként

msgid  Compression
msgstr Tömörítés

msgctxt compression
